diff --git a/src/Cafe/OS/libs/snd_core/ax_voice.cpp b/src/Cafe/OS/libs/snd_core/ax_voice.cpp
--- a/src/Cafe/OS/libs/snd_core/ax_voice.cpp
+++ b/src/Cafe/OS/libs/snd_core/ax_voice.cpp
@@ -556,7 +556,15 @@
 	sint32 AXSetVoiceDeviceMix(AXVPB* vpb, sint32 device, sint32 deviceIndex, AXCHMIX_DEPR* mix)
 	{
 		if (vpb == nullptr)
 			return -4;
 		if (mix == nullptr)
 			return -3;
+		cemuLog_log(LogType::SoundAPI,
+			"LEGO-AUDIO-DIAG AXSetVoiceDeviceMix voice={} device={} index={} buses=[{:04x}/{}, {:04x}/{}, {:04x}/{}, {:04x}/{}]",
+			(uint32)vpb->index,
+			device,
+			deviceIndex,
+			(uint32)_swapEndianU16(mix[0].vol), (sint32)(sint16)_swapEndianU16((uint16)mix[0].delta),
+			(uint32)_swapEndianU16(mix[1].vol), (sint32)(sint16)_swapEndianU16((uint16)mix[1].delta),
+			(uint32)_swapEndianU16(mix[2].vol), (sint32)(sint16)_swapEndianU16((uint16)mix[2].delta),
+			(uint32)_swapEndianU16(mix[3].vol), (sint32)(sint16)_swapEndianU16((uint16)mix[3].delta));
 		sint32 r = AXIsValidDevice(device, deviceIndex);
 		if (r)
 			return r;
@@ -744,7 +752,13 @@
 	void AXSetVoiceVe(AXVPB* vpb, AXPBVE* ve)
 	{
 		AXVPBInternal_t* internal = __AXVPBInternalVoiceArray + (sint32)vpb->index;
 		internal->veVolume = ve->currentVolume;
 		internal->veDelta = ve->currentDelta;
+		cemuLog_log(LogType::SoundAPI,
+			"LEGO-AUDIO-DIAG AXSetVoiceVe voice={} volume=0x{:04x} delta={}",
+			(uint32)vpb->index,
+			(uint32)_swapEndianU16(ve->currentVolume),
+			(sint32)(sint16)_swapEndianU16((uint16)ve->currentDelta));
 		AXSetSyncFlag(vpb, AX_SYNCFLAG_VE);
 		AXVoiceProtection_Acquire(vpb);
 	}
